# syntax=docker/dockerfile:1
# Context: frontend after verification/extraction of the immutable release artifact.
FROM nginx:1.27-alpine
COPY dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY csp.conf /etc/nginx/snippets/sso-csp.conf
COPY security-headers.conf /etc/nginx/snippets/sso-security-headers.conf
RUN test -f /usr/share/nginx/html/build-info.json \
    && test -z "$(find /usr/share/nginx/html -name '*.map' -print -quit)"
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
