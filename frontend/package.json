{
  "name": "alxprgs-sso-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint src e2e public/theme vite.config.ts playwright*.config.ts",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "test:unit": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "test:components": "vitest run .component.test.tsx --environment jsdom",
    "test:e2e": "playwright test",
    "test:e2e:email": "playwright test --config playwright.email.config.ts",
    "test:telemetry:browser": "playwright test --config playwright.telemetry.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-tooltip": "1.2.16",
    "@sentry/react": "11.2.0",
    "cmdk": "1.1.1",
    "geist": "1.7.2",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "qrcode.react": "4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@sentry/bundler-plugins": "11.2.0",
    "@sentry/cli": "3.8.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
