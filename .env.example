# ==============================================================================
# ПРИМЕР КОНФИГУРАЦИОННОГО ФАЙЛА ALXPRGS SSO
# ВНИМАНИЕ: Все приведенные значения являются демонстрационными и безопасными.
# НЕ используйте демонстрационные ключи в продуктивном окружении!
# ==============================================================================

# Окружение: development | testing | production
ENVIRONMENT=development
DEBUG=false

# Базовые сетевые параметры
HOST=0.0.0.0
PORT=8000
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# OIDC Issuer URL (по умолчанию для alxprgs.tech)
OIDC_ISSUER=https://auth.alxprgs.tech

# Подключение к PostgreSQL
DATABASE_URL=postgresql+psycopg://sso_user:sso_secure_password@db:5432/sso_db
DATABASE_URL_SYNC=postgresql+psycopg://sso_user:sso_secure_password@db:5432/sso_db

# Параметры базы данных для Docker Compose
POSTGRES_USER=sso_user
POSTGRES_PASSWORD=sso_secure_password
POSTGRES_DB=sso_db

# Секрет подписи сессий и CSRF (в production должен быть случайной строкой 64+ символа)
SESSION_SECRET_KEY=change-me-to-a-secure-random-string-at-least-64-characters-long

# Приватный RSA-ключ для подписи OIDC JWT (в формате PEM или путь к файлу)
# Если не указан при старте в development, сервер генерирует временный ключ в памяти
JWT_PRIVATE_KEY_PEM=
JWT_KEY_ID=default-rsa-key-1

# ФЛАГИ ОТЛОЖЕННЫХ ВОЗМОЖНОСТЕЙ (СТРОГО FALSE ПО УМОЛЧАНИЮ)
FEATURE_TOTP_ENABLED=false
FEATURE_PASSKEY_ENABLED=false
FEATURE_RECOVERY_CODES_ENABLED=false
FEATURE_EMAIL_VERIFICATION_ENABLED=false
REQUIRE_VERIFIED_EMAIL=false

# Ключ шифрования TOTP (32-байтовая base64-строка для Fernet, требуется при FEATURE_TOTP_ENABLED=true)
TOTP_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# WebAuthn / Passkey параметры (используются при FEATURE_PASSKEY_ENABLED=true)
WEBAUTHN_RP_ID=auth.alxprgs.tech
WEBAUTHN_RP_NAME=ALXPRGS SSO
WEBAUTHN_ORIGIN=https://auth.alxprgs.tech

# SMTP параметры (используются при FEATURE_EMAIL_VERIFICATION_ENABLED=true)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@alxprgs.tech
SMTP_USE_TLS=false

# Политика времени жизни токенов (в секундах)
AUTH_CODE_TTL_SECONDS=60
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=604800
SESSION_IDLE_TIMEOUT_SECONDS=43200
SESSION_ABSOLUTE_TIMEOUT_SECONDS=604800
